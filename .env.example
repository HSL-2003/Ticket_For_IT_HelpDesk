# ==============================================================================
# IT HelpDesk Ticket System — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Port
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (Turso Cloud vs. Local SQLite Fallback)
# ------------------------------------------------------------------------------

# Option 1: Turso Cloud Database (Recommended for Vercel / Serverless production)
# When TURSO_DATABASE_URL is set, the system connects via @libsql/client.
# TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-jwt

# Option 2: Local SQLite Fallback (Used when TURSO_DATABASE_URL is omitted or unset)
# Uses local SQLite file or in-memory database (:memory:)
DB_PATH=./data/helpdesk.db

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Directory for legacy attachment files (when not stored as BLOB)
UPLOADS_DIR=./uploads/tickets
